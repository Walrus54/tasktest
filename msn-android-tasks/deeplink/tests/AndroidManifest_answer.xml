<?xml version="1.0" encoding="utf-8"?>
<!--
    FIXED App Links configuration.

    android:autoVerify="true" makes the OS verify domain ownership via the
    assetlinks.json well-known file before granting this app the link, so a
    rogue app registering the same host no longer intercepts it. android:path
    matches only the exact path this activity actually handles.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.mobsec.deeplink">

    <application
        android:allowBackup="false"
        android:label="DeepLink"
        android:supportsRtl="true"
        android:theme="@style/Theme.Material3.DayNight.NoActionBar">

        <activity
            android:name=".ResetPasswordActivity"
            android:exported="true">
            <intent-filter android:autoVerify="true">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data
                    android:scheme="https"
                    android:host="mobsec.app"
                    android:path="/reset-password" />
            </intent-filter>
        </activity>
    </application>
</manifest>
